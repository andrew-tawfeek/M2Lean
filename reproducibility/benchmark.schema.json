{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andrew-tawfeek/M2Lean/raw/v0.2.0/reproducibility/benchmark.schema.json",
  "title": "M2Lean raw benchmark result",
  "type": "object",
  "required": [
    "schema_version",
    "created_utc",
    "source",
    "environment",
    "configuration",
    "phases"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "created_utc": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["git_commit", "git_dirty", "git_status_porcelain", "tracked_diff_sha256"],
      "properties": {
        "git_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "git_dirty": { "type": "boolean" },
        "git_status_porcelain": { "type": "string" },
        "tracked_diff_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": true
    },
    "environment": { "type": "object" },
    "configuration": { "type": "object" },
    "phases": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "array",
          "items": { "$ref": "#/$defs/generationCase" }
        },
        "checker": { "$ref": "#/$defs/checkerPhase" },
        "lean_elaboration": {
          "type": "array",
          "items": { "$ref": "#/$defs/leanCase" }
        }
      },
      "additionalProperties": false
    },
    "error": { "type": "string" }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "required": ["wall_ms", "max_rss_kib", "exit_code", "timed_out", "stdout", "stderr"],
      "properties": {
        "wall_ms": { "type": "number", "minimum": 0 },
        "max_rss_kib": { "type": "integer", "minimum": 0 },
        "exit_code": { "type": "integer" },
        "timed_out": { "type": "boolean" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["command", "cwd", "expected_exit", "warmups", "samples", "summary"],
      "properties": {
        "command": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "cwd": { "type": "string" },
        "expected_exit": { "type": "integer" },
        "warmups": { "type": "array", "items": { "$ref": "#/$defs/sample" } },
        "samples": {
          "type": "array",
          "items": { "$ref": "#/$defs/sample" },
          "minItems": 1
        },
        "summary": {
          "type": "object",
          "required": ["median_wall_ms", "peak_rss_kib"],
          "properties": {
            "median_wall_ms": { "type": "number", "minimum": 0 },
            "peak_rss_kib": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "generationCase": {
      "type": "object",
      "required": ["id", "script", "outputs", "measurement"],
      "properties": {
        "id": { "type": "string" },
        "script": { "type": "string" },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/artifact" }, "minItems": 1 },
        "measurement": { "$ref": "#/$defs/measurement" }
      },
      "additionalProperties": false
    },
    "checkerDocument": {
      "type": "object",
      "required": [
        "path",
        "document_id",
        "claim_count",
        "bytes",
        "sha256",
        "no_claim_parse_validate_baseline",
        "full_verification",
        "estimated_claim_check_ms"
      ],
      "properties": {
        "path": { "type": "string" },
        "document_id": { "type": ["string", "null"] },
        "claim_count": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "no_claim_parse_validate_baseline": { "$ref": "#/$defs/measurement" },
        "full_verification": { "$ref": "#/$defs/measurement" },
        "estimated_claim_check_ms": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "checkerPhase": {
      "type": "object",
      "required": ["startup_baseline", "documents", "phase_note"],
      "properties": {
        "startup_baseline": { "$ref": "#/$defs/measurement" },
        "documents": {
          "type": "array",
          "items": { "$ref": "#/$defs/checkerDocument" },
          "minItems": 1
        },
        "phase_note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "leanCase": {
      "type": "object",
      "required": ["id", "source", "measurement"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "measurement": { "$ref": "#/$defs/measurement" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
