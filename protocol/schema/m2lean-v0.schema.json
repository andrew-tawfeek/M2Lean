{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/andrew-tawfeek/M2Lean/protocol/schema/m2lean-v0.schema.json",
  "title": "M2Lean protocol document, version 0.1.0",
  "description": "Structural pre-filter only. The normative specification is protocol/SPEC.md; passing this schema does NOT imply a document is valid (canonical forms, dependency order, dimensions, and primality are checked semantically by consumers).",
  "type": "object",
  "required": ["m2leanVersion", "documentId", "objects", "claims", "provenance"],
  "properties": {
    "m2leanVersion": { "const": "0.1.0" },
    "documentId": { "type": "string", "minLength": 1 },
    "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "integerString": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)$" },
    "rational": {
      "type": "object",
      "required": ["num", "den"],
      "properties": {
        "num": { "$ref": "#/$defs/integerString" },
        "den": { "$ref": "#/$defs/integerString" }
      },
      "additionalProperties": false
    },
    "coefficient": {
      "oneOf": [{ "$ref": "#/$defs/rational" }, { "$ref": "#/$defs/integerString" }]
    },
    "term": {
      "type": "object",
      "required": ["coefficient", "exponents"],
      "properties": {
        "coefficient": { "$ref": "#/$defs/coefficient" },
        "exponents": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      },
      "additionalProperties": false
    },
    "polynomial": {
      "type": "object",
      "required": ["terms"],
      "properties": { "terms": { "type": "array", "items": { "$ref": "#/$defs/term" } } },
      "additionalProperties": false
    },
    "monomialOrder": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "enum": ["Lex", "GRevLex"] } },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "type": "string" } },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "PrimeField" } } },
          "then": { "required": ["characteristic"],
                    "properties": { "characteristic": { "$ref": "#/$defs/integerString" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "PolynomialRing" } } },
          "then": {
            "required": ["coefficients", "variables", "monomialOrder"],
            "properties": {
              "coefficients": { "type": "string" },
              "variables": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "monomialOrder": { "$ref": "#/$defs/monomialOrder" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "Ideal" } } },
          "then": { "required": ["ring", "generators"],
                    "properties": { "ring": { "type": "string" },
                                    "generators": { "type": "array", "items": { "$ref": "#/$defs/polynomial" } } } }
        },
        {
          "if": { "properties": { "kind": { "const": "Matrix" } } },
          "then": { "required": ["ring", "rows", "cols", "entries"],
                    "properties": { "ring": { "type": "string" },
                                    "rows": { "type": "integer", "minimum": 0 },
                                    "cols": { "type": "integer", "minimum": 0 },
                                    "entries": { "type": "array",
                                                 "items": { "type": "array", "items": { "$ref": "#/$defs/polynomial" } } } } }
        },
        {
          "if": { "properties": { "kind": { "const": "GradedFreeModule" } } },
          "then": { "required": ["ring", "degrees"],
                    "properties": { "ring": { "type": "string" },
                                    "degrees": { "type": "array", "items": { "type": "integer" } } } }
        }
      ]
    },
    "claim": {
      "type": "object",
      "required": ["id", "kind", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["PolynomialIdentity", "IdealMembership", "SpanInclusion",
                            "GroebnerBasis", "ChainComplex", "GradedComplex"] },
        "evidence": { "type": "object" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["producer", "producerVersion"],
      "properties": {
        "producer": { "type": "string" },
        "producerVersion": { "type": "string" },
        "packageVersion": { "type": "string" },
        "algorithm": { "type": "string" },
        "options": { "type": "object" },
        "deterministic": { "type": "boolean" }
      }
    }
  }
}
